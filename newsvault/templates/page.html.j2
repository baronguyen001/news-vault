{% extends "base.html.j2" %}

{% block body %}
<script type="application/json" id="nv-config">{{ config_json }}</script>
<div id="gate" class="gate">
  <form class="gate__box" id="gate-form">
    <h1 class="gate__title">{{ meta.site }}</h1>
    <p class="gate__hint">Nhập mật khẩu để mở nội dung.</p>
    <input class="gate__input" id="gate-pass" type="password" autocomplete="current-password"
           autofocus aria-label="Mật khẩu" required>
    <label class="gate__remember" id="gate-remember-row">
      <input type="checkbox" id="gate-remember">
      <span>Nhớ thiết bị này</span>
    </label>
    <button class="gate__btn" id="gate-go" type="submit">Mở</button>
    <p class="gate__err" id="gate-err" role="alert" hidden></p>
  </form>
</div>
<main id="app" hidden></main>
<noscript>Trang này cần JavaScript để giải mã nội dung.</noscript>
{% endblock %}

{% block scripts %}
<script defer src="{{ base }}assets/crypto.js"></script>
<script defer src="{{ base }}assets/unlock-store.js"></script>
<script defer src="{{ base }}assets/icons.js"></script>
<script defer src="{{ base }}assets/videos.js"></script>
<script defer src="{{ base }}assets/video-library.js"></script>
<script defer src="{{ base }}assets/curated.js"></script>
<script defer src="{{ base }}assets/reports.js"></script>
<script defer src="{{ base }}assets/substack.js"></script>
<script defer src="{{ base }}assets/posts.js"></script>
<script defer src="{{ base }}assets/indie.js"></script>
<script defer src="{{ base }}assets/search.js"></script>
<script defer src="{{ base }}assets/keyterms.js"></script>
<script defer src="{{ base }}assets/user.js"></script>
<script defer src="{{ base }}assets/share.js"></script>
<script defer src="{{ base }}assets/palette.js"></script>
<script defer src="{{ base }}assets/layout.js"></script>
<script defer src="{{ base }}assets/topics.js"></script>
<script defer src="{{ base }}assets/read.js"></script>
<script defer src="{{ base }}assets/modal.js"></script>
<script defer src="{{ base }}assets/search-page.js"></script>
<script defer src="{{ base }}assets/quality.js"></script>
<script defer src="{{ base }}assets/app.js"></script>
{% endblock %}
