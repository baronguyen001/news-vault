# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Password that unlocks the published site (used at build time to derive the AES key).
NEWSVAULT_PASSWORD=change-me

# Path to the news-hunter SQLite database that news-vault reads (read-only).
NEWSVAULT_DB=E:\Indie Hacker\news-hunter\news_hunter.db

# Output directory for the generated site (GitHub Pages source: main /docs).
NEWSVAULT_OUT=docs

# Google Gemini API key: used for the daily brief and the category illustrations.
# Both features fail soft - the site still builds without this key.
GEMINI_API_KEY=

# Illustrations: which back-end draws them.
#   aihub  - MK1 AI Hub (default). Richer editorial art, ~67s per image, ~59 KB per WebP.
#   gemini - Google Gemini. Flatter, ~15s per image, ~21 KB per WebP.
# Whichever you pick, the other one is used automatically if the first fails.
NEWSVAULT_IMAGE_PROVIDER=gemini
AI_HUB_BASE_URL=https://ai-hub.mk1technology.net/v1
AI_HUB_KEY=
NEWSVAULT_AIHUB_IMAGE_MODEL=orchestration
NEWSVAULT_IMAGE_FALLBACK=1

# Optional overrides
NEWSVAULT_BRIEF_MODEL=gemini-2.5-flash
NEWSVAULT_IMAGE_MODEL=gemini-2.5-flash-image
NEWSVAULT_SITE_URL=https://baronguyen001.github.io/news-vault
