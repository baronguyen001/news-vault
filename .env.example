# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Password that unlocks the published site (used at build time to derive the AES key).
NEWSVAULT_PASSWORD=change-me

# Path to the news-hunter SQLite database that news-vault reads (read-only).
NEWSVAULT_DB=E:\Indie Hacker\news-hunter\news_hunter.db

# Output directory for the generated site (GitHub Pages source: main /docs).
NEWSVAULT_OUT=docs

# Google Gemini API key: used for the daily brief only. It fails soft - without a key
# the brief falls back to the day's top five by score and the site still builds.
GEMINI_API_KEY=

# Optional overrides
NEWSVAULT_BRIEF_MODEL=gemini-2.5-flash
NEWSVAULT_CACHE=.cache
NEWSVAULT_SITE_URL=https://baronguyen001.github.io/news-vault

# Optional second source: the youtube-summarizer database. Unset = archive without videos.
NEWSVAULT_VIDEO_DB=E:\Indie Hacker\youtube-summarizer\youtube_summarizer.db

# Optional third source: the x-pulse database (important + trending posts from X). Read
# through its `x_feed` view, read-only. Unset = archive without the X section.
NEWSVAULT_X_DB=E:\x-pulse\x_pulse.db

# Optional Telegram notification from scripts/run_daily.ps1: one message after a run that
# actually published something, and an alert when a build or push fails. Leave either key
# empty and the job logs a line and carries on. A failing notification never fails the run.
NEWSVAULT_TELEGRAM_TOKEN=
NEWSVAULT_TELEGRAM_CHAT=
